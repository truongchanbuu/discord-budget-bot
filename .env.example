# Process environment only; this file is not loaded automatically.
FUNDGUARD_LOG_LEVEL=info
FUNDGUARD_MODE=offline

# Connected mode is opt-in. All five Discord/binding fields are required; changes require restart.
# Provision the token through a secure local prompt or secret facility, not shell history.
# FUNDGUARD_DISCORD_TOKEN=
# FUNDGUARD_DISCORD_GUILD_ID=
# FUNDGUARD_DISCORD_OWNER_ID=
# FUNDGUARD_OWNER_REF=
# FUNDGUARD_OWNER_STATE=enabled
# disabled denies this configured owner. Independent guild members remain separately authorized.
# Owner reference bytes are preserved.

# Optional finance journal: Supabase-managed PostgreSQL; ignored in offline mode.
# Embedded migrations run on enabled startup. Without this setting: readiness-only bot.
# Copy the actual Session pooler host/user from Supabase Connect; placeholders below are not usable.
# Disable Data API before first startup. Use session5432, not transaction6543; URL-encode the password.
# FUNDGUARD_FINANCE_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require

# Independent optional overrides; database enables private spaces by default.
# Omit category to create/reuse a private Tài chính category at startup.
# Omit onboarding IDs to allow @bot bắt đầu in any accessible ordinary guild text channel.
# Supply real category/text-channel IDs from your configured guild, never token/password values here.
# Server Members Intent and the documented minimum permissions are required; no Administrator.
# FUNDGUARD_FINANCE_CATEGORY_ID=CATEGORY_ID
# FUNDGUARD_FINANCE_ONBOARDING_CHANNEL_IDS=ONBOARDING_TEXT_CHANNEL_ID
